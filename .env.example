# ==============================================================================
# K-POS Frontend (PWA) Environment Configuration Template
# Salin file ini menjadi `.env` atau `.env.local`:
#   cp .env.example .env
# ==============================================================================

# URL Backend API (NestJS)
# Default dev: http://localhost:3000
# Production: kosongkan jika menggunakan reverse proxy domain yang sama
VITE_API_URL=http://localhost:3000

# Mode Demo Offline (Opsional: true | false)
# Set ke `true` jika ingin mencoba aplikasi kasir dengan produk demo tanpa backend
VITE_DEMO_MODE=false
